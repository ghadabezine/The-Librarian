# Copy to .env and adjust. All settings use the RAG_ prefix (see backend/app/core/config.py).

# Generation back-end: llamacpp (local, default) | anthropic | extractive
RAG_LLM_PROVIDER=llamacpp
RAG_LLM_MODEL=qwen2.5-3b-instruct-q4_k_m.gguf
RAG_LLM_THREADS=4

# Only needed with RAG_LLM_PROVIDER=anthropic. Never commit a real key.
RAG_ANTHROPIC_API_KEY=
RAG_ANTHROPIC_MODEL=claude-opus-5-5

# Retrieval
RAG_RETRIEVAL_MODE=hybrid_rerank
RAG_TOP_K=5
RAG_RERANK_K=20
RAG_MIN_RERANK_SCORE=0.01

# Optimisations (see optimisation.md)
RAG_MAX_CONTEXT_CHARS=6000
RAG_SKIP_RERANK_WHEN_CONFIDENT=false
RAG_QUERY_CACHE_SIZE=0
RAG_LLM_PROMPT_CACHE=false
